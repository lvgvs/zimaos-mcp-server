# Environment example for zimaos-mcp-server
# Copy to a real file (e.g. /path/to/your.env) and fill in values.
# NEVER commit real credentials or tokens. This file contains placeholders only.

# Base URL of the ZimaOS web/API as seen from where the server runs.
# Inside a container on this host, use http://host.docker.internal (see Compose).
ZIMAOS_URL=http://host.docker.internal

# A ZimaOS account allowed to manage compose apps and read system info.
ZIMAOS_USERNAME=CHANGE_ME_zimaos_username

# Password for the above account.
ZIMAOS_PASSWORD=CHANGE_ME_zimaos_password

# Bearer token MCP clients must present on `Authorization: Bearer <token>`.
# Must be at least 32 characters; there is no default. Generate one, e.g.:
#   openssl rand -hex 32
MCP_AUTH_TOKEN=CHANGE_ME_at_least_32_characters_long_secret_token

# Optional (defaults shown).
# Enable reversible app controls (start_app/stop_app/restart_app). Keep false unless needed.
ALLOW_APP_CONTROL=false

# Enable safe Compose installation separately from reversible app controls.
# Keep false unless needed. Risky Compose still requires the later approval flow.
ALLOW_APP_INSTALL=false

# HTTP listen port inside the container (matches image EXPOSE + health check).
PORT=3000

# Log verbosity: debug | info | warn | error.
LOG_LEVEL=info
